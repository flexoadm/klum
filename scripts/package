#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."

source ./scripts/version
export GOOS=linux
platform="linux/$ARCH"
if [ "$ARCH" = arm ]; then
    export GOARM=${GOARM:-7}
    platform="$platform/v$GOARM"
fi
./scripts/build
./scripts/artifacts

docker build --platform "$platform" --build-arg "TARGETARCH=$ARCH" -f package/Dockerfile -t "${REPO}:${TAG}" .
echo "Built ${REPO}:${TAG}"
