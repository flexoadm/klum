#!/bin/bash
# Sourced by build and packaging scripts from the repository root.
COMMIT=$(git rev-parse --short HEAD)
DIRTY=""
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    DIRTY="-dirty"
fi

if [ -z "${VERSION:-}" ]; then
    if [ "${GITHUB_REF_TYPE:-}" = tag ]; then
        VERSION=$GITHUB_REF_NAME
    elif GIT_TAG=$(git describe --tags --exact-match HEAD 2>/dev/null); then
        VERSION=$GIT_TAG
    else
        VERSION=$COMMIT
    fi
    VERSION="${VERSION}${DIRTY}"
fi

ARCH=${GOARCH:-$(go env GOARCH)}
SUFFIX="-${ARCH}"
TAG=${TAG:-$VERSION}
REPO=${REPO:-klum}
