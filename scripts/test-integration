#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
command -v kind >/dev/null
command -v docker >/dev/null

# Images published with kind v0.32.0; pin digests for reproducibility.
images=(
 'kindest/node:v1.33.12@sha256:3f5c8443c620245e4d355cfe09e96a91ead32ceaa569d3f1ca9edf0cb2fe2ff4'
 'kindest/node:v1.34.8@sha256:02722c2dedddcfc00febf5d27fbeb9b7b2c14294c82109ff4a85d89ac9ba3256'
 'kindest/node:v1.35.5@sha256:ce977ae6d65918d0b58a5f8b5e940429c2ce42fa3a5619ec2bbc60b949c0ac95'
 'kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5'
)
workdir=$(mktemp -d)
cluster="klum-api-test-$$"
cleanup() {
 kind delete cluster --name "$cluster"
 rm -rf "$workdir"
}
trap cleanup EXIT
export KUBECONFIG="$workdir/kubeconfig"
export KLUM_DISPOSABLE_CLUSTER=true
for image in "${images[@]}"; do
 echo "Testing $image"
 kind create cluster --name "$cluster" --image "$image" --kubeconfig "$KUBECONFIG" --wait 120s
 go test -tags=integration -count=1 -v ./tests/integration
 kind delete cluster --name "$cluster"
done
