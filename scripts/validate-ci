#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."

go generate .
git diff --exit-code -- pkg/apis pkg/generated
untracked=$(git ls-files --others --exclude-standard -- pkg/apis pkg/generated)
if [ -n "$untracked" ]; then
    echo "Generated files are not tracked:"
    echo "$untracked"
    exit 1
fi
